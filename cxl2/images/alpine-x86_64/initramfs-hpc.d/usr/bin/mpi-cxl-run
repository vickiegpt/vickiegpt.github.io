#!/bin/sh
set -eu

if [ "$#" -eq 0 ]; then
    echo "usage: mpi-cxl-run <program> [args...]" >&2
    echo "sets LD_PRELOAD to /opt/cxlmpi/lib/\${MPI_CXL_SHIM:-libmpi_cxl_shim.so}" >&2
    exit 2
fi

shim=${MPI_CXL_SHIM:-libmpi_cxl_shim.so}
case "$shim" in
    /*) shim_path=$shim ;;
    *) shim_path=/opt/cxlmpi/lib/$shim ;;
esac

export LD_LIBRARY_PATH="/opt/cxlmpi/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_PRELOAD="$shim_path${LD_PRELOAD:+:$LD_PRELOAD}"
export MPI_CXL_DEBUG=${MPI_CXL_DEBUG:-1}
exec "$@"
