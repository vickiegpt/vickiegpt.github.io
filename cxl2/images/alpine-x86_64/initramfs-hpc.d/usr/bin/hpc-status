#!/bin/sh
echo "hpc tools: OpenMPI/GROMACS optional initramfs is active."
printf "available:"
for tool in mpirun mpiexec ompi_info prte prterun gmx_mpi gmx llama-cli llama-bench cxl_init cxl_recover_meta mpi-smoke; do
    if command -v "$tool" >/dev/null 2>&1; then
        printf " %s" "$tool"
    fi
done
echo
echo "safe checks: llama-bench --help; gmx --version; ldd /usr/bin/mpirun"
echo "note: OpenMPI startup can hang under browser QEMU/TCG; use strace/ldd before ompi_info or mpi-smoke."
