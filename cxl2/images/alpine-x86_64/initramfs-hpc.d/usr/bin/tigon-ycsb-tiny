#!/bin/sh
set -u

timeout_sec=${TIGON_TIMEOUT_SEC:-25}
cmd="/usr/bin/tigon-ycsb --logtostderr=1 --id=0 --servers=127.0.0.1:10010 --threads=1 --io=1 --partition_num=1 --keys=1000 --granule_count=1 --time_to_warmup=0 --time_to_run=1 --query=rmw --protocol=Silo --cpu_affinity=false --cpu_core_id=0 --use_cxl_transport=true --cxl_backend=shm --cxl_memory_resource=/tmp/tigon-cxl"

echo "$cmd"
if command -v timeout >/dev/null 2>&1; then
    timeout "$timeout_sec" sh -c "exec $cmd"
else
    sh -c "exec $cmd"
fi
rc=$?
echo "tigon-ycsb-tiny rc=$rc"
exit "$rc"
