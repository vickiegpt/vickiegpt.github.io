#!/bin/sh
set -u

PATH=/opt/cxlcuda/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH
export PATH
CXL_CUDA_HOME=${CXL_CUDA_HOME:-/opt/cxlcuda}
export LD_LIBRARY_PATH="$CXL_CUDA_HOME/lib:$CXL_CUDA_HOME/bin${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export CXL_CUDA_DEBUG=${CXL_CUDA_DEBUG:-1}

run_timeout() {
    seconds=$1
    shift
    if command -v timeout >/dev/null 2>&1; then
        timeout "$seconds" "$@"
    else
        "$@"
    fi
}

echo "CXL Type2 / CXL-CUDA smoke"
echo "kernel: $(uname -r 2>/dev/null)"
echo "cmdline:"
cat /proc/cmdline 2>/dev/null | tr ' ' '\n' | grep -E 'cxl|hetgpu|memsim|qemu' || true

echo
echo "PCI CXL/accelerator devices:"
lspci -nn 2>/dev/null | grep -Ei 'cxl|0b40|0d92|8086:0d92' || true

echo
echo "CXL/DAX driver setup:"
if command -v cxl-dax-setup >/dev/null 2>&1; then
    cxl-dax-setup --quiet || true
else
    echo "WARN: cxl-dax-setup is missing"
fi

echo
echo "CXL sysfs:"
find /sys/bus/cxl/devices -maxdepth 2 -print 2>/dev/null | sort || true

echo
echo "CXL-CUDA payload:"
ls -l "$CXL_CUDA_HOME/lib/libcuda.so.1" "$CXL_CUDA_HOME/bin/cuda_test" 2>/dev/null || true
if [ ! -x "$CXL_CUDA_HOME/bin/cuda_test" ]; then
    echo "FAIL: $CXL_CUDA_HOME/bin/cuda_test is missing"
    exit 1
fi

echo
echo "Running cuda_test through the CXL Type2 libcuda shim:"
run_timeout 25 "$CXL_CUDA_HOME/bin/cuda_test"
rc=$?
echo "cuda_test rc=$rc"
exit "$rc"
