#!/bin/sh
set -eu

np=2
while [ "$#" -gt 0 ]; do
    case "$1" in
        -np|--np)
            np=$2
            shift 2
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done

if [ "$#" -eq 0 ]; then
    echo "usage: gromacs-cxl-run [-np N] <gmx_mpi args...>" >&2
    echo "example: gromacs-cxl-run -np 2 mdrun -s bench.tpr -nsteps 1000" >&2
    exit 2
fi

exec mpi-cxl-run mpi-local-run -np "$np" gmx_mpi "$@"
