#!/bin/sh
set -eu

echo "Tigon smoke"
command -v tigon-ycsb
command -v tigon-tpcc
command -v cxl_init || true
command -v cxl_recover_meta || true
ls -l /opt/tigon/kernel_module 2>/dev/null || true

echo
echo "YCSB flags:"
tigon-ycsb -help 2>&1 | head -80 || true

echo
echo "TPCC flags:"
tigon-tpcc -help 2>&1 | head -80 || true

echo
echo "PASS: Tigon binaries are present. Use: tigon-ycsb-tiny"
