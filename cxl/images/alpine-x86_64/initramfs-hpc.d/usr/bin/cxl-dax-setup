#!/bin/sh
set -u

PATH=/usr/bin:/bin:/usr/sbin:/sbin:$PATH
export PATH

quiet=0
try_region=0
for arg in "$@"; do
    case "$arg" in
        -q|--quiet) quiet=1 ;;
        --try-region|--create-region) try_region=1 ;;
        -h|--help)
            echo "usage: cxl-dax-setup [--quiet] [--try-region]"
            echo "loads CXL Type2/Type3 and DAX modules, then prints cxl/daxctl state."
            exit 0
            ;;
    esac
done

say() {
    [ "$quiet" -eq 1 ] && return 0
    echo "$@"
}

section() {
    [ "$quiet" -eq 1 ] && return 0
    echo
    echo "$@"
}

ensure_mount() {
    fs=$1
    target=$2
    mkdir -p "$target"
    mountpoint -q "$target" 2>/dev/null && return 0
    mount -t "$fs" "$fs" "$target" 2>/dev/null || true
}

load_module() {
    name=$1
    if grep -qw "^$name" /proc/modules 2>/dev/null; then
        say "module present: $name"
        return 0
    fi
    if modprobe "$name" 2>/tmp/cxl-dax-modprobe.err; then
        say "module loaded: $name"
        return 0
    fi
    err=$(cat /tmp/cxl-dax-modprobe.err 2>/dev/null || true)
    [ -n "$err" ] && say "warn: modprobe $name: $err"
    return 1
}

ensure_mount proc /proc
ensure_mount sysfs /sys
ensure_mount devtmpfs /dev

section "CXL/DAX module load"
for mod in \
    einj \
    cxl_core \
    cxl_port \
    cxl_pci \
    cxl_acpi \
    cxl_mem \
    cxl_pmem \
    cxl_cache \
    cxl_type2_accel \
    device_dax \
    dax_cxl \
    dax_pmem \
    dax_hmem \
    kmem \
    cxl_pmu
do
    load_module "$mod" || true
done

section "PCI CXL devices"
lspci -nn 2>/dev/null | grep -Ei 'cxl|0b40|0502|0d92|7075|1b36' || true

section "CXL sysfs"
find /sys/bus/cxl/devices -maxdepth 3 -print 2>/dev/null | sort || true

section "cxl list"
if command -v cxl >/dev/null 2>&1; then
    cxl list -vvv 2>/tmp/cxl-list.err || {
        cat /tmp/cxl-list.err 2>/dev/null || true
        true
    }
else
    echo "warn: cxl command not found"
fi

if [ "$try_region" -eq 1 ] && command -v cxl >/dev/null 2>&1; then
    section "try CXL region creation"
    memdev=$(cxl list -M 2>/dev/null | sed -n 's/.*"memdev"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    decoder=$(cxl list -D 2>/dev/null | sed -n 's/.*"decoder"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    if [ -n "$memdev" ] && [ -n "$decoder" ]; then
        say "creating region with decoder=$decoder memdev=$memdev"
        cxl create-region -t ram -d "$decoder" -w 1 "$memdev" 2>/tmp/cxl-create-region.err \
            || cxl create-region -d "$decoder" -w 1 "$memdev" 2>>/tmp/cxl-create-region.err \
            || cat /tmp/cxl-create-region.err 2>/dev/null || true
    else
        say "skip: no memdev/decoder pair found"
    fi
fi

section "daxctl list"
if command -v daxctl >/dev/null 2>&1; then
    daxctl list -vvv 2>/tmp/daxctl-list.err || {
        cat /tmp/daxctl-list.err 2>/dev/null || true
        true
    }
else
    echo "warn: daxctl command not found"
fi

section "DAX char devices"
find /dev -maxdepth 2 \( -name 'dax*' -o -name 'pmem*' \) -print 2>/dev/null | sort || true

section "CXL/DAX dmesg tail"
dmesg 2>/dev/null | grep -Ei 'cxl|dax|cedt|acpi0016|decoder|region|type2|0d92' | tail -120 || true

if find /dev -maxdepth 2 -name 'dax*' -print 2>/dev/null | grep -q .; then
    echo "PASS: DAX character device exists."
    exit 0
fi
if find /sys/bus/cxl/devices -maxdepth 1 \( -name 'mem*' -o -name 'decoder*' -o -name 'cache*' \) 2>/dev/null | grep -q .; then
    echo "WARN: CXL sysfs exists but no /dev/dax* yet. Try: cxl-dax-setup --try-region"
    exit 2
fi
echo "FAIL: no CXL sysfs objects and no DAX device."
exit 1
