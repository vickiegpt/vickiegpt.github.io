#!/bin/sh
set -eu

run_mpi=0
np=2
if [ "${1:-}" = "--mpi" ]; then
    run_mpi=1
    np=${2:-2}
fi
echo "GROMACS/CXL-MPI smoke"
command -v gmx
command -v gmx_mpi
command -v mpi-local-run
command -v mpi-cxl-run
if [ "${GMX_PROBE:-0}" = "1" ]; then
    echo
    echo "Probing gmx --version (may SIGILL on browser QEMU without AVX/SIMD CPU features)"
    if command -v timeout >/dev/null 2>&1; then
        timeout -k 1 5 gmx --version 2>&1 | head -20 || \
            echo "WARN: gmx --version failed; use qemu_cpu=max or a no-SIMD GROMACS build"
    else
        gmx --version 2>&1 | head -20 || \
            echo "WARN: gmx --version failed; use qemu_cpu=max or a no-SIMD GROMACS build"
    fi
else
    echo "Skipping gmx --version by default; set GMX_PROBE=1 to test the packaged GROMACS binary."
fi

echo
echo "CXL MPI tests:"
for t in test_mpi_cxl test_p2p test_collectives test_onesided; do
    if command -v "$t" >/dev/null 2>&1; then
        printf "  %-18s %s\n" "$t" "$(command -v "$t")"
    fi
done

if command -v test_mpi_cxl >/dev/null 2>&1; then
    echo
    if [ "$run_mpi" -eq 1 ]; then
        echo "Running test_mpi_cxl through LD_PRELOAD shim with mpirun, np=$np"
        exec mpi-cxl-run mpi-local-run --timeout 35 -np "$np" test_mpi_cxl
    fi
    echo "Running singleton test_mpi_cxl through LD_PRELOAD shim"
    if command -v timeout >/dev/null 2>&1; then
        exec timeout -k 2 25 mpi-cxl-run test_mpi_cxl
    fi
    exec mpi-cxl-run test_mpi_cxl
fi

echo "WARN: test_mpi_cxl is not available"
exit 1
