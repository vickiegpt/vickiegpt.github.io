{
  "$schema": "../claude-edge/node_modules/wrangler/config-schema.json",
  "name": "asplos-claude-static",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "asplos.dev/claude/*",
      "zone_name": "asplos.dev"
    },
    {
      "pattern": "asplos.dev/about/runtime-manifest.json",
      "zone_name": "asplos.dev"
    }
  ]
}
